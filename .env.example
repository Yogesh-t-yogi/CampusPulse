# Copy to .env (never commit .env). Used by start-dev.ps1 (local) and docker-compose.yml.

# PostgreSQL password (local install or Docker)
DB_PASSWORD=postgres
# Optional: other database URL / user (defaults: jdbc:postgresql://localhost:5432/campuspulse, postgres)
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/campuspulse
# SPRING_DATASOURCE_USERNAME=postgres

# At least 32 characters; keep it stable so sign-ins survive restarts
JWT_SECRET=change-me-to-a-long-random-string-of-32-plus-chars

# Groq API key for AI extraction and recommendations
GROQ_API_KEY=

# Comma-separated emails that become platform admins
ADMIN_EMAILS=

# Local demo only: creates the demo college and demo accounts with this password
DEMO_USERS_PASSWORD=
