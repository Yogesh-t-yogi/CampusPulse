# Copy to .env (never commit .env). Used by docker-compose.yml.
DB_PASSWORD=postgres
# At least 32 characters
JWT_SECRET=change-me-to-a-long-random-string-of-32-plus-chars
GROQ_API_KEY=
# Comma-separated emails that become ADMIN (job catalog management)
ADMIN_EMAILS=
# Local demo only: creates admin@ / faculty@ / student@campuspulse.local with this password
DEMO_USERS_PASSWORD=
