# CampusPulse settings. Copy to .env and fill in (never commit .env).
# Used by start-dev.cmd / start-dev.ps1 (local) and docker-compose.yml.

# ---------------------------------------------------------------- required
# Password of your PostgreSQL "postgres" user (the one you chose when installing PostgreSQL).
DB_PASSWORD=

# Secret that signs sign-in tokens: any random text, 32+ characters. Keep it stable,
# or everyone is signed out on restart. PowerShell to make one:
#   [Convert]::ToBase64String((1..48 | % { Get-Random -Max 256 }))
JWT_SECRET=

# ---------------------------------------------------------------- AI providers
# Chat AI: at least ONE of GEMINI_API_KEY / GROQ_API_KEY is needed for syllabus extraction,
# recommendations and learning plans. Tried in LLM_ORDER (default gemini,groq); a missing,
# rate-limited or failing one is skipped.

# LlamaParse (LlamaCloud, https://cloud.llamaindex.ai) reads scanned PDF pages first; free tier
# about 10,000 credits/month. Not a chat model. Key starts with llx-.
LLAMA_CLOUD_API_KEY=
# Tier: fast (text only) | cost_effective (OCR, default) | agentic | agentic_plus
# LLAMAPARSE_TIER=cost_effective
# EU accounts: LLAMA_CLOUD_BASE_URL=https://api.cloud.eu.llamaindex.ai

# Gemini (free key: https://aistudio.google.com/apikey). Free-tier data may be used by Google.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash
# GEMINI_VISION_MODEL=gemini-3.5-flash

# Groq (free key: https://console.groq.com/keys)
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-20b
# GROQ_VISION_MODEL=qwen/qwen3.8-27b

# Order to try providers
# LLM_ORDER=gemini,groq

# ---------------------------------------------------------------- scanned PDFs
# Pages without selectable text are read by LlamaParse, then (if that fails) by a vision model
# (Gemini -> Groq), then Tesseract if installed. Nothing to install.
#   auto   = AI reads only scanned/garbled pages (default)
#   always = AI reads every page (best structure, more API calls)
#   off    = never use AI for pages (Tesseract is used only if installed)
# PDF_AI_MODE=auto
# PDF_AI_MAX_PAGES=60
# PDF_AI_PARALLEL=3

# ---------------------------------------------------------------- optional
# Comma-separated emails that become platform admins at startup / registration.
ADMIN_EMAILS=

# Let anyone sign up (true) or only accept accounts made by a HOD / college admin (false, default).
# With false, only the ADMIN_EMAILS above can use the sign-up page (first-time setup).
SELF_REGISTRATION=false

# First password for accounts made by a HOD / college admin (8+ characters). Empty: a random one-time
# password per account. Also used to create the ADMIN_EMAILS platform admin at first start.
# Everyone must change it at first sign-in.
DEFAULT_USER_PASSWORD=

# Account emails (welcome + password reset). Any SMTP provider (Gmail app password, Brevo, SendGrid,
# Amazon SES, college mail). Leave MAIL_HOST empty to send no emails.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
APP_URL=http://localhost:5173

# Local demo only: set a password to create the demo college and demo accounts
# (admin@campuspulse.local etc.). Leave empty anywhere else.
DEMO_USERS_PASSWORD=

# Other database (defaults: jdbc:postgresql://localhost:5432/campuspulse, user postgres)
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/campuspulse
# SPRING_DATASOURCE_USERNAME=postgres

# Frontend address(es) allowed to call the API, comma-separated (default: http://localhost:5173)
# CORS_ALLOWED_ORIGINS=http://localhost:5173

# Requests per minute per IP: sign-in/register and AI calls (0 = off)
# RATE_LIMIT_AUTH=10
# RATE_LIMIT_AI=30
