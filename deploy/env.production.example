# Production settings for docker-compose.prod.yml. On the server:
#   cp deploy/env.production.example .env   then fill every value, then: chmod 600 .env
# Never commit the real .env.

# ---------------------------------------------------------------- site address
# With a domain (recommended, gives HTTPS):  SITE_ADDRESS=campuspulse.example.in  APP_URL=https://campuspulse.example.in
# Without a domain (HTTP on the server IP):  SITE_ADDRESS=:80                     APP_URL=http://<elastic-ip>
SITE_ADDRESS=
APP_URL=

# ---------------------------------------------------------------- secrets (generate new ones, do not reuse your laptop values)
# openssl rand -base64 24
DB_PASSWORD=
# openssl rand -base64 48
JWT_SECRET=

# ---------------------------------------------------------------- platform admin and accounts
# Your email; this account is created at first start with DEFAULT_USER_PASSWORD (change it at first sign-in).
ADMIN_EMAILS=
# 8+ characters. Needed once to create the platform admin; you may clear it afterwards (random passwords then).
DEFAULT_USER_PASSWORD=

# ---------------------------------------------------------------- AI providers (separate production keys)
GEMINI_API_KEY=
GROQ_API_KEY=
LLAMA_CLOUD_API_KEY=
LLM_ORDER=gemini,groq

# ---------------------------------------------------------------- email (same values as on your laptop work)
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# ---------------------------------------------------------------- optional
# Copy daily database backups to this S3 bucket (needs an IAM role on the instance).
BACKUP_S3_BUCKET=
# Java memory for the backend (t3.medium: -Xmx1g is fine).
JAVA_TOOL_OPTIONS=-Xms256m -Xmx1g
